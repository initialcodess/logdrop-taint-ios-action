# fastlane — LogDrop Taint
#
# Add this to your Fastfile. Running it BEFORE the Xcode build makes sense: with
# findings it stops before you spend time compiling.
#
# LICENCE: the LOGDROP_LICENSE environment variable must be set (as a CI secret).
#
# SENDING TO THE PANEL (optional) — three variables, and all three are needed:
#
#   PANEL_URL        your panel's address
#   LOGDROP_LICENSE  your key (already required for the scan)
#   BUNDLE_ID        your application's bundle id, AS REGISTERED IN THE PANEL
#
# Miss any one and nothing is sent: the step prints a line and stays green,
# which is easy not to notice. A BUNDLE_ID the panel does not recognise for
# this project is refused (400) and FAILS the step, so a wrong id is loud
# rather than silent.

desc "Taint (data-flow) scan over the source"
lane :security_scan do
  bin_dir = File.expand_path("~/.logdrop/bin")

  # Install it (skipped if already installed)
  sh("LOGDROP_VERSION=v1.24.1 LOGDROP_BIN_DIR=#{bin_dir} bash #{__dir__}/../install-logdrop-taint.sh")

  # The scan. sh(...) raises on a non-zero exit; we catch it by hand so the code can
  # be read and acted on — 1 (findings) is not the same thing as 2 (licence).
  status = 0
  Dir.chdir(File.expand_path("..", __dir__ + "/../..")) do
    system(
      "#{bin_dir}/logdrop-taint", "Sources",
      "--sarif", "logdrop-taint.sarif",
      "--repo-root", Dir.pwd,
      "--verbose", "--fail-on-findings"
    )
    status = $?.exitstatus
  end

  # Send the report on before acting on the exit code, so a failing scan still
  # reaches the panel. Does nothing unless PANEL_URL is set.
  sh("bash #{__dir__}/../report-to-panel.sh logdrop-taint.sarif")

  case status
  when 0 then UI.success("LogDrop Taint: no findings.")
  when 1 then UI.user_error!("LogDrop Taint reported findings — see logdrop-taint.sarif")
  when 2 then UI.user_error!("The LogDrop licence is invalid or expired.")
  when 3 then UI.user_error!("There is an error in the .logdrop.json config file.")
  else        UI.user_error!("LogDrop Taint returned an unexpected exit code: #{status}")
  end
end
