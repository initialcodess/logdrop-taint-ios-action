// Jenkins — LogDrop Taint
//
// REQUIREMENT: an agent labelled macos. Your own Mac mini is enough; Xcode and a
// Swift toolchain are NOT needed (the analyzer is a self-contained binary).
//
// LICENCE: add it to Jenkins credentials as "Secret text" named `logdrop-license`.
// Do NOT write the key into this file.
//
// SENDING TO THE PANEL (optional) — three variables, and all three are needed:
//
//   PANEL_URL        your panel's address
//   LOGDROP_LICENSE  your key (already required for the scan)
//   BUNDLE_ID        your application's bundle id, AS REGISTERED IN THE PANEL
//
// Miss any one and nothing is sent: the step prints a line and stays green,
// which is easy not to notice. A BUNDLE_ID the panel does not recognise for
// this project is refused (400) and FAILS the step, so a wrong id is loud
// rather than silent.
// Set PANEL_URL and BUNDLE_ID as environment variables on the job.
pipeline {
  agent { label 'macos' }

  environment {
    LOGDROP_VERSION = 'v1.24.1'
    LOGDROP_BIN_DIR = "${WORKSPACE}/.logdrop/bin"
  }

  stages {
    stage('Install LogDrop Taint') {
      steps {
        sh 'bash examples/install-logdrop-taint.sh'
      }
    }

    stage('Scan the source') {
      steps {
        withCredentials([string(credentialsId: 'logdrop-license', variable: 'LOGDROP_LICENSE')]) {
          // Exit code 1 means findings → the build turns FAILURE.
          // 2 is a licence problem, 3 a config error — kept apart so they can be told apart.
          sh '''
            "$LOGDROP_BIN_DIR/logdrop-taint" Sources \
              --sarif logdrop-taint.sarif \
              --repo-root "$WORKSPACE" \
              --verbose \
              --fail-on-findings
          '''
        }
      }
    }
  }

  post {
    always {
      // With findings the stage failed; archive the report anyway.
      archiveArtifacts artifacts: 'logdrop-taint.sarif', allowEmptyArchive: true

      // And send it on, if a panel is configured. Without PANEL_URL this prints a
      // line and does nothing, so it is safe to leave in.
      withCredentials([string(credentialsId: 'logdrop-license', variable: 'LOGDROP_LICENSE')]) {
        sh '''
          APP_NAME="$JOB_NAME" VERSION="$BRANCH_NAME" COMMIT="$GIT_COMMIT" \
            bash examples/report-to-panel.sh logdrop-taint.sarif
        '''
      }
    }
  }
}
